<section class="reviews">
  <div class="container">
    <div class="section-heading">
      <div>
        <p class="section-heading__eyebrow">Customer stories</p>

        <h2 class="section-heading__title">Loved by thousands.</h2>
      </div>

      <a href="#">
        Read all reviews
      </a>
    </div>

    <div class="reviews__grid">
      <article class="review">
        <div class="review__rating">★★★★★</div>

        <p class="review__text">
          "Beautiful products and surprisingly fast shipping. Everything
          feels much more premium in person."
        </p>

        <span class="review__author">
          Sarah M. — Chicago, IL
        </span>
      </article>

      <article class="review">
        <div class="review__rating">★★★★★</div>

        <p class="review__text">
          "Finally found a store with products that actually make my
          apartment better."
        </p>

        <span class="review__author">
          Daniel R. — Austin, TX
        </span>
      </article>

      <article class="review">
        <div class="review__rating">★★★★★</div>

        <p class="review__text">
          "The quality, packaging and design are excellent. Definitely
          ordering again."
        </p>

        <span class="review__author">
          Jessica T. — New York, NY
        </span>
      </article>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Reviews",
  "settings": []
}
{% endschema %}