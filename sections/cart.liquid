<section class="cart-page">
  <div class="container">

    <div class="cart-page__header">
      <p class="cart-page__eyebrow">Your selection</p>

      <h1 class="cart-page__title">
        Shopping cart
      </h1>
    </div>


    {% if cart.item_count > 0 %}

      <div class="cart-page__layout">

        <!-- CART ITEMS -->

        <div class="cart-items">

          {% for item in cart.items %}

            <article class="cart-item">

              <div class="cart-item__image">
                <a href="{{ item.url }}">

                  {% if item.image %}
                    <img
                      src="{{ item.image | image_url: width: 500 }}"
                      alt="{{ item.image.alt | escape | default: item.product.title | escape }}"
                      width="{{ item.image.width }}"
                      height="{{ item.image.height }}"
                      loading="lazy"
                    >
                  {% endif %}

                </a>
              </div>


              <div class="cart-item__content">

                <div class="cart-item__info">

                  <a href="{{ item.url }}">
                    <h2 class="cart-item__title">
                      {{ item.product.title }}
                    </h2>
                  </a>

                  {% unless item.product.has_only_default_variant %}
                    <p class="cart-item__variant">
                      {{ item.variant.title }}
                    </p>
                  {% endunless %}

                  <p class="cart-item__price">
                    {{ item.final_price | money }}
                  </p>

                </div>


                <div class="cart-item__actions">

                  <div class="cart-item__quantity">

                    <a
                      href="{{ routes.cart_change_url }}?line={{ forloop.index }}&quantity={{ item.quantity | minus: 1 }}"
                      aria-label="Decrease quantity"
                    >
                      −
                    </a>

                    <span>
                      {{ item.quantity }}
                    </span>

                    <a
                      href="{{ routes.cart_change_url }}?line={{ forloop.index }}&quantity={{ item.quantity | plus: 1 }}"
                      aria-label="Increase quantity"
                    >
                      +
                    </a>

                  </div>


                  <a
                    class="cart-item__remove"
                    href="{{ item.url_to_remove }}"
                  >
                    Remove
                  </a>

                </div>

              </div>

            </article>

          {% endfor %}

        </div>


        <!-- CART SUMMARY -->

        <aside class="cart-summary">

          <h2 class="cart-summary__title">
            Order summary
          </h2>


          <div class="cart-summary__row">

            <span>
              Subtotal
            </span>

            <span>
              {{ cart.total_price | money }}
            </span>

          </div>


          <div class="cart-summary__row">

            <span>
              Shipping
            </span>

            <span>
              Calculated at checkout
            </span>

          </div>


          <div class="cart-summary__divider"></div>


          <div class="cart-summary__total">

            <span>
              Total
            </span>

            <span>
              {{ cart.total_price | money }}
            </span>

          </div>


          {% form 'cart', cart %}

            <button
              class="button button--primary cart-summary__checkout"
              type="submit"
              name="checkout"
            >
              Proceed to checkout
            </button>

          {% endform %}


          <p class="cart-summary__note">
            Secure checkout. Taxes calculated at checkout.
          </p>

        </aside>

      </div>


    {% else %}

      <!-- EMPTY CART -->

      <div class="cart-empty">

        <p class="cart-page__eyebrow">
          Your selection
        </p>

        <h2>
          Your cart is empty.
        </h2>

        <p>
          Discover something for your space.
        </p>

        <a
          class="button button--primary"
          href="{{ routes.all_products_collection_url }}"
        >
          Continue shopping
        </a>

      </div>

    {% endif %}

  </div>
</section>


{% schema %}
{
  "name": "Cart",
  "settings": []
}
{% endschema %}