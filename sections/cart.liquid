<section class="cart-page">

  <div class="container">

    <div class="cart-page__header">

      <p class="cart-page__eyebrow">
        Your selection
      </p>

      <h1 class="cart-page__title">
        Shopping cart
      </h1>

    </div>


    {% if cart.item_count > 0 %}

      <div class="cart-page__layout">

        <!-- CART ITEMS -->

        <div class="cart-items" id="cart-items">

          {% for item in cart.items %}

            <article class="cart-item">

              <div class="cart-item__image">

                {% if item.image %}

                  <a href="{{ item.url }}">

                    <img
                      src="{{ item.image | image_url: width: 400 }}"
                      width="{{ item.image.width }}"
                      height="{{ item.image.height }}"
                      alt="{{ item.image.alt | default: item.product.title | escape }}"
                      loading="lazy"
                    >

                  </a>

                {% endif %}

              </div>


              <div class="cart-item__content">

                <h2 class="cart-item__title">

                  <a href="{{ item.url }}">
                    {{ item.product.title }}
                  </a>

                </h2>


                {% unless item.product.has_only_default_variant %}

                  <p class="cart-item__variant">
                    {{ item.variant.title }}
                  </p>

                {% endunless %}


                <p class="cart-item__price">
                  {{ item.final_price | money }}
                </p>


                <div class="cart-item__quantity">

                  <a
                    href="{{ routes.cart_change_url }}?line={{ forloop.index }}&quantity={{ item.quantity | minus: 1 }}"
                    class="quantity__button"
                    aria-label="Decrease quantity"
                  >
                    −
                  </a>


                  <span>
                    {{ item.quantity }}
                  </span>


                  <a
                    href="{{ routes.cart_change_url }}?line={{ forloop.index }}&quantity={{ item.quantity | plus: 1 }}"
                    class="quantity__button"
                    aria-label="Increase quantity"
                  >
                    +
                  </a>

                </div>


                <a
                  href="{{ item.url_to_remove }}"
                  class="cart-item__remove"
                >
                  Remove
                </a>

              </div>


              <div class="cart-item__total">

                {{ item.final_line_price | money }}

              </div>

            </article>

          {% endfor %}

        </div>


        <!-- CART SUMMARY -->

        <aside class="cart-summary">

          <h2 class="cart-summary__title">
            Order summary
          </h2>


          <div class="cart-summary__row">

            <span>
              Subtotal
            </span>

            <span id="cart-subtotal">
              {{ cart.total_price | money }}
            </span>

          </div>


          <div class="cart-summary__row">

            <span>
              Shipping
            </span>

            <span>
              Calculated at checkout
            </span>

          </div>


          <div class="cart-summary__divider"></div>


          <div class="cart-summary__total">

            <span>
              Total
            </span>

            <span id="cart-total">
              {{ cart.total_price | money }}
            </span>

          </div>


          <form
            action="{{ routes.cart_url }}"
            method="post"
          >

            <button
              class="button button--primary cart-summary__checkout"
              type="submit"
              name="checkout"
            >
              Proceed to checkout
            </button>

          </form>


          <p class="cart-summary__note">
            Secure checkout. Taxes calculated at checkout.
          </p>

        </aside>

      </div>

    {% else %}

      <div class="cart-empty">

        <p class="cart-empty__text">
          Your cart is currently empty.
        </p>

        <a
          href="{{ routes.all_products_collection_url }}"
          class="button button--primary"
        >
          Continue shopping
        </a>

      </div>

    {% endif %}

  </div>

</section>


{% schema %}
{
  "name": "Cart",
  "settings": [],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}