<section class="lifestyle">
  <div class="container lifestyle__container">

    <div class="lifestyle__content">

      <p class="lifestyle__eyebrow">
        Better spaces. Better days.
      </p>

      <h2 class="lifestyle__title">
        Small changes.
        <br>
        Big impact.
      </h2>

      <p class="lifestyle__description">
        Thoughtfully selected pieces designed to bring comfort, beauty,
        and function into your everyday life.
      </p>

      <a
        class="button button--primary"
        href="{{ routes.root_url }}pages/about"
      >
        Our story
      </a>

    </div>

    <div class="lifestyle__image">
      <img
        src="{{ 'lifestyle.interior.jpeg' | asset_url }}"
        alt="Elegant modern home interior"
        loading="lazy"
        width="1200"
        height="800"
      >
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Lifestyle",
  "settings": []
}
{% endschema %}