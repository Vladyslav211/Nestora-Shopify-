<section class="hero">
  <div class="container hero__container">

    <div class="hero__content">
      <p class="hero__eyebrow">
        Smart home. Beautiful life.
      </p>

      <h1 class="hero__title">
        Thoughtful design
        <br>
        for modern living.
      </h1>

      <p class="hero__description">
        Functional home essentials that bring beauty, comfort, and
        simplicity to every space.
      </p>

      <div class="hero__actions">
        <a
          class="button button--primary"
          href="{{ routes.all_products_collection_url }}"
        >
          Shop bestsellers
        </a>

        <a
          class="button button--secondary"
          href="/collections"
        >
          Explore collections
        </a>
      </div>

      <div class="hero__social-proof">
        <div class="hero__avatars">
          <!-- avatars later -->
        </div>

        <div class="hero__rating">
          <div class="hero__stars">★★★★★</div>

          <p>20,000+ happy customers</p>
        </div>
      </div>
    </div>

    <div class="hero__image">
      <img
        src="{{ 'hero.modern.jpeg' | asset_url }}"
        alt="Modern living room with warm ambient lighting"
        loading="eager"
      >
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": []
}
{% endschema %}