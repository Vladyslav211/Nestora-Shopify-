<section class="collection-hero">
  <div class="container">
    <div class="collection-hero__content">

      <p class="collection-hero__eyebrow">
        {% case collection.handle %}
          {% when 'lighting' %}
            Lighting collection
          {% when 'organization' %}
            Organization collection
          {% when 'smart-home' %}
            Smart home collection
          {% when 'bathroom' %}
            Bathroom collection
          {% when 'kitchen' %}
            Kitchen collection
          {% when 'home-decor' %}
            Home decor collection
          {% else %}
            Collection
        {% endcase %}
      </p>

      <div class="collection-hero__row">

        <h1 class="collection-hero__title">
          {% case collection.handle %}
            {% when 'lighting' %}
              Designed to glow.
            {% when 'organization' %}
              Made for order.
            {% when 'smart-home' %}
              Smarter living.
            {% when 'bathroom' %}
              Everyday rituals.
            {% when 'kitchen' %}
              Better kitchen.
            {% when 'home-decor' %}
              Complete the space.
            {% else %}
              All collections
          {% endcase %}
        </h1>

        <p class="collection-hero__count">
          {{ collection.products_count }} products
        </p>

      </div>

    </div>
  </div>
</section>


<section class="collection-products">
  <div class="container">

    <div class="products-grid">

      {% for product in collection.products %}

        <article class="product-card">

          <a
            class="product-card__link"
            href="{{ product.url }}"
          >

            <div class="product-card__image">

              {% if product.featured_image %}
                <img
                  src="{{ product.featured_image | image_url: width: 1200 }}"
                  alt="{{ product.title | escape }}"
                  width="{{ product.featured_image.width }}"
                  height="{{ product.featured_image.height }}"
                  loading="lazy"
                >
              {% endif %}

            </div>

            <div class="product-card__info">

              <p class="product-card__category">
                {{ product.type }}
              </p>

              <h2 class="product-card__title">
                {{ product.title }}
              </h2>

              <div class="product-card__rating">
                ★★★★★
                <span>
                  ({{ product.metafields.reviews.rating_count.value | default: 0 }})
                </span>
              </div>

              <div class="product-card__price">

                <strong>
                  {{ product.price | money }}
                </strong>

                {% if product.compare_at_price > product.price %}
                  <del>
                    {{ product.compare_at_price | money }}
                  </del>
                {% endif %}

              </div>

            </div>

          </a>

        </article>

      {% else %}

        <p class="products-empty">
          No products found in this collection.
        </p>

      {% endfor %}

    </div>

  </div>
</section>


{% schema %}
{
  "name": "Collection",
  "settings": []
}
{% endschema %}