        </div>

        <div class="collection-card__content">
          <p class="collection-card__category">
            COLLECTION 02
          </p>

          <h3>Organization</h3>

          <span>Explore →</span>
        </div>
      </a>

      <!-- SMART HOME -->
      <a
        class="collection-card"
