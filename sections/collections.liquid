<section class="collections">
  <div class="container">

    <div class="section-heading">
      <div>
        <p class="section-heading__eyebrow">Explore</p>

        <h2 class="section-heading__title">
          Shop by collection
        </h2>
      </div>

      <a
        class="section-heading__link"
        href="{{ routes.collections_url }}"
      >
        View all
      </a>
    </div>

    <div class="collections__grid">

      <!-- LIGHTING -->
      <a
        class="collection-card"
        href="/collections/lighting"
      >
        <div class="collection-card__image">
          <img
            src="{{ 'collection-lighting.jpeg' | asset_url }}"
            alt="Lighting collection"
            loading="lazy"
          >
        </div>

        <div class="collection-card__content">
          <p class="collection-card__category">
            COLLECTION 01
          </p>

          <h3>Lighting</h3>

          <span>Explore →</span>
        </div>
      </a>

      <!-- ORGANIZATION -->
      <a
        class="collection-card"
        href="/collections/organization"
      >
        <div class="collection-card__image">
          <img
            src="{{ 'collection-organizer.jpeg' | asset_url }}"
            alt="Organization collection"
            loading="lazy"
